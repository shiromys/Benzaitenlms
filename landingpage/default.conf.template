server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    # Clean URLs: /pricing -> /pricing/index.html, custom 404 page.
    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }
}
